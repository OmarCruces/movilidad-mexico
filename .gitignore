# ================================
# Movilidad México — .gitignore
# ================================

# Entornos virtuales
venv/
env/
.env/
.venv/

# Variables de entorno (¡nunca subir credenciales!)
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Distribución / empaquetado
dist/
build/
*.egg-info/
*.egg

# Base de datos local
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# VS Code
.vscode/
*.code-workspace

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# pytest
.pytest_cache/
htmlcov/
.coverage

# MyPy
.mypy_cache/
